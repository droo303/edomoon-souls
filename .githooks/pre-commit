#!/usr/bin/env bash
# Refuse a commit that adds an env file or something that looks like a real
# secret. Enabled for this repository with:  git config core.hooksPath .githooks
# A false positive can be committed anyway with  git commit --no-verify
set -u
fail=0

# 1. Env files, whatever the folder (examples and templates are fine).
envs=$(git diff --cached --name-only --diff-filter=ACR | grep -E '(^|/)(\.env($|\.)|[^/]*\.env$)' | grep -vE '\.(example|sample|template)$|(^|/)example\.env$')
if [ -n "$envs" ]; then
  echo "pre-commit: env file(s) staged, not committed:" >&2
  echo "$envs" | sed 's/^/  /' >&2
  fail=1
fi

# 2. Added lines that look like real keys (Paperclip's pcp_ and pcfc_ keys too) (the names of the files only, never
#    the values, are printed).
patterns='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|(^|[^A-Za-z0-9_-])sk-(proj-)?[A-Za-z0-9_-]{32,}|sk_live_[0-9A-Za-z]{16,}|rk_live_[0-9A-Za-z]{16,}|whsec_[0-9A-Za-z]{16,}|AKIA[0-9A-Z]{16}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|xox[baprs]-[0-9A-Za-z-]{10,}|[0-9]{8,10}:AA[0-9A-Za-z_-]{33}|AIza[0-9A-Za-z_-]{35}|pcp_[a-z_]*[0-9a-f]{32,}|pcfc_[A-Za-z0-9_-]{40,}'
hits=$(git diff --cached -U0 --no-color --diff-filter=ACM | awk '/^\+\+\+ b\//{f=substr($0,7)} /^\+[^+]/{print f"\t"substr($0,2)}' | grep -E -e "$patterns" | cut -f1 | sort -u)
if [ -n "$hits" ]; then
  echo "pre-commit: something that looks like a secret key is staged in:" >&2
  echo "$hits" | sed 's/^/  /' >&2
  fail=1
fi

[ $fail -eq 0 ] || echo "pre-commit: move secrets to a gitignored .env file (or use --no-verify for a false positive)." >&2
exit $fail
